# ============================================================================
#  Copy to .env.local for local dev. Add the same keys in Vercel under
#  Project -> Settings -> Environment Variables for deployment.
#
#  Only the 2 vars marked REQUIRED must be set. Everything else has a working
#  default; Redis is optional but strongly recommended (see below).
# ============================================================================


# ---------------------------------------------------------------------------
#  1. OpenRouter
# ---------------------------------------------------------------------------

# REQUIRED. Create at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# BOOTSTRAP ONLY. The live model list is the `models` table in Postgres —
# add, reorder, enable or disable models there and the change is picked up
# within CACHE_TTL (about a minute), no redeploy.
#
# These two are the safety net used when that table is empty or unreachable,
# so a fresh or broken database still answers.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,deepseek/deepseek-v4-flash-0731:free

# Request reasoning tokens. reasoning_details are stored and replayed so the
# model continues its chain of thought across turns. Set false to disable.
OPENROUTER_REASONING=true

# Override only if you route through a proxy or gateway. Default:
# https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Abort a model call after this long. Keep it BELOW the function maxDuration
# in vercel.json (60000) or the platform kills the request first.
OPENROUTER_TIMEOUT_MS=55000


# ---------------------------------------------------------------------------
#  2. Neon Postgres  -  durable transcript
# ---------------------------------------------------------------------------

# REQUIRED. Neon Console -> your project -> Connection string.
# Use the POOLED string: the host must contain "-pooler".
# Keep ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require


# ---------------------------------------------------------------------------
#  3. Redis  -  hot sliding window  (optional)
# ---------------------------------------------------------------------------
# A standard Redis connection string. Use rediss:// for TLS, which every
# managed provider requires (Upstash, Redis Cloud, Railway, Aiven, ...).
#
# Leave it unset and the app still works: every turn just reads its history
# from Postgres instead of cache.

REDIS_URL=rediss://default:PASSWORD@HOST:PORT


# ---------------------------------------------------------------------------
#  4. Conversation behaviour
# ---------------------------------------------------------------------------

# Past user/assistant exchanges replayed as context. 50 turns = 100 messages.
# Lower it if you hit a model's context limit or want cheaper calls.
HISTORY_TURNS=50

# How long a cached window survives without being touched. 86400 = 24h.
CACHE_TTL_SECONDS=86400

# Optional system prompt prepended to every conversation.
# SYSTEM_PROMPT=You are a concise, helpful assistant.


# ---------------------------------------------------------------------------
#  5. Web search  (optional)
# ---------------------------------------------------------------------------
# Two shapes, both passed alongside the chat completion:
#
#   tool   (default)  tools: [{ type: "openrouter:web_search" }]
#                     The MODEL decides whether to search, so a question it can
#                     already answer costs nothing. Supports domain filters and
#                     max_uses. REQUIRES a tool-calling model - check yours:
#                       curl -s https://openrouter.ai/api/v1/models | jq -r \
#                         '.data[] | select(.supported_parameters|index("tools")) | .id'
#
#   plugin            plugins: [{ id: "web" }]
#                     Always searches before the model runs. Works with ANY
#                     model, including free ones with no tool support - but it
#                     searches (and bills) on every message.
#
# COST: OpenRouter bills each search, EVEN ON FREE MODELS. WEB_SEARCH_MAX_USES
# is the ceiling per turn and your main cost lever.

WEB_SEARCH_AVAILABLE=true      # false hides the toggle entirely
WEB_SEARCH_DEFAULT=false       # whether a message searches unless told otherwise
WEB_SEARCH_MODE=tool           # tool | plugin
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_USES=3          # searches per turn (tool mode)

# auto | native | exa | firecrawl | parallel | perplexity
# WEB_SEARCH_ENGINE=auto
# WEB_SEARCH_CONTEXT_SIZE=medium        # low | medium | high
# WEB_SEARCH_MAX_CHARACTERS=2000
# WEB_SEARCH_MAX_TOTAL_RESULTS=20
# WEB_SEARCH_ALLOWED_DOMAINS=nih.gov,who.int
# WEB_SEARCH_EXCLUDED_DOMAINS=reddit.com


# ---------------------------------------------------------------------------
#  6. MCP tools  (optional, OFF by default)
# ---------------------------------------------------------------------------
# Lets the model call tools on remote MCP servers listed in the `mcp_servers`
# table. Only Streamable-HTTP servers work: a stdio server needs a child
# process, which a serverless function cannot host.
#
# REQUIRES A TOOL-CALLING MODEL. Check yours before enabling:
#   curl -s https://openrouter.ai/api/v1/models | jq -r \
#     '.data[] | select(.supported_parameters|index("tools")) | .id' | grep ':free'

MCP_ENABLED=false
MCP_MAX_ITERATIONS=3       # tool rounds per turn; each is another model call
MCP_TOOLS_TTL_SECONDS=300  # how long a server's tool list is cached

# Exa is seeded in `mcp_servers` and works on a rate-limited free tier with no
# key. Set this to lift the limit. The key is read from the environment - the
# database only stores the NAME of this variable, never its value.
# EXA_API_KEY=your_exa_api_key


# ---------------------------------------------------------------------------
#  7. Semantic recall  (optional, OFF by default)
# ---------------------------------------------------------------------------
# Embeds past messages into pgvector and pulls related ones into new prompts.
#
#   off           no recall (default)
#   conversation  recall older turns of the SAME conversation, once it has
#                 outgrown HISTORY_TURNS. Safe: nothing crosses a chat.
#   global        recall from EVERY conversation in the database.
#
# Read this before choosing `global`: this app has no authentication, so one
# visitor's messages can surface inside another visitor's prompt. Only use it
# where every author is known to consent - a personal deployment, or an
# internal tool. Do not combine it with health or other sensitive data.
MEMORY_SCOPE=off

# The embedding model. INDEPENDENT of the chat models in the `models` table —
# changing which LLM answers does not touch embeddings.
#
# Changing THIS is safe and needs no migration: `model` is part of the
# embeddings primary key, so searches ignore vectors from any other model and
# the corpus re-embeds itself in the background. Recall is thin until it
# catches up; watch progress at GET /api/memory, and reclaim the old vectors
# with DELETE /api/memory?model=<old-id>.
EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional. Asks a Matryoshka-capable model for a narrower vector so it fits
# the VECTOR(1536) column. Needed for models wider than 1536 — and required
# above 2000, which is pgvector's HNSW limit for the `vector` type.
# Only send this if the model supports truncation; others reject it.
# EMBEDDING_DIMENSIONS=1536

MEMORY_TOP_K=4
MEMORY_MIN_SIMILARITY=0.75
MEMORY_MIN_CHARS=40

# Route embeddings only to providers that do not retain prompts.
EMBEDDING_DENY_DATA_COLLECTION=true


# ---------------------------------------------------------------------------
#  8. App metadata  -  sent to OpenRouter as HTTP-Referer / X-Title
# ---------------------------------------------------------------------------
# Server-side only, so no NEXT_PUBLIC_ prefix: that would inline the values
# into the browser bundle for no benefit.
#
# On Vercel APP_URL falls back to VERCEL_URL automatically, so it is optional
# there; set it explicitly once you have a custom domain.

APP_URL=http://localhost:3000
APP_TITLE=agentic-ai
